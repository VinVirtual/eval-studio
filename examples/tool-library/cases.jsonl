{"id": "join-documents", "input": "What should I bring to join?", "expected": "A photo ID and proof of address (membership.md).", "tags": ["membership"], "checks": [{"type": "contains", "all": ["photo ID", "proof of address"]}, {"type": "source", "id": "membership"}]}
