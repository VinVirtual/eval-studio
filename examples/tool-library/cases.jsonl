{"id": "loan-limit", "input": "How many tools can a member borrow at a time?", "expected": "Up to 5 (borrowing.md).", "tags": ["borrowing", "must-pass"], "weight": 2, "checks": [{"type": "number", "value": 5}, {"type": "source", "id": "borrowing"}]}
{"id": "loan-period", "input": "How long is the loan period?", "expected": "7 days (borrowing.md).", "tags": ["borrowing", "must-pass"], "weight": 2, "checks": [{"type": "contains", "value": "7 days"}, {"type": "max-length", "words": 30}]}
{"id": "loan-renewal", "input": "Can a loan be renewed?", "expected": "Once, for another 7 days, if nobody is waiting (borrowing.md).", "tags": ["borrowing"], "checks": [{"type": "contains", "all": ["once", "7 days"]}, {"type": "not-contains", "value": "twice"}]}
{"id": "power-tools-age", "input": "Is there an age limit for power tools?", "expected": "Members aged 18 or over (borrowing.md). The safety page also mentions power tools, so the right page must rank first.", "tags": ["borrowing", "retrieval"], "checks": [{"type": "contains", "value": "18"}, {"type": "source", "id": "borrowing", "maxRank": 1}]}
