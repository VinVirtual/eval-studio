// Cases for the example bot. Every expected fact comes from the files in docs/.
// Some cases fail on purpose: they show what a failing check looks like in the report.
{"id": "hours-weekday", "input": "What are the opening times on a Wednesday?", "expected": "10 am to 6 pm (hours.md). Wednesday is not named in the handbook, only 'Tuesday to Friday'.", "note": "Fails on purpose: the bot matches words and does not know Wednesday lies between Tuesday and Friday.", "tags": ["hours", "reasoning"], "checks": [{"type": "contains", "all": ["10 am", "6 pm"]}, {"type": "source", "id": "hours", "maxRank": 1}]}
