{
  "name": "My bot",
  "cases": "cases.jsonl",
  "target": { "type": "module", "path": "./target.mjs", "export": "answer" },
  "run": { "concurrency": 4, "retries": 1, "timeoutMs": 30000, "repeat": 1 },
